{
  "name": "focus-log",
  "private": true,
  "description": "Focus Log 공통 개발 환경과 프론트엔드·백엔드 모노레포",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "dev": "pnpm --dir app dev",
    "dev:backend": "pnpm --dir backend start:dev",
    "build": "pnpm --dir app build",
    "build:backend": "pnpm --dir backend build",
    "lint": "pnpm --dir app lint",
    "lint:backend": "pnpm --dir backend lint",
    "test:backend": "pnpm --dir backend test && pnpm --dir backend test:e2e",
    "typecheck": "pnpm --dir app typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.7"
  }
}

{
  "name": "@focus-log/app",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "node scripts/dev.mjs next",
    "dev:electron:compile": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev:electron": "node scripts/dev.mjs electron",
    "build": "pnpm build:next && pnpm build:electron",
    "build:next": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test:dev": "node --test scripts/dev.test.mjs"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0"
  }
}
